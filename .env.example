# Copy to .env and adjust. Real secrets (e.g. a PostgreSQL password) belong only in .env, which is git-ignored.
APP_ENV=development
LOG_LEVEL=INFO

# SQLite (default, local development)
DATABASE_URL=sqlite:///./convoops.db

# PostgreSQL (install a driver first: pip install "psycopg[binary]")
# DATABASE_URL=postgresql+psycopg://convoops_user:change-me@localhost:5432/convoops

DB_ECHO=false
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# --- Message processing (Phase 2) ---
# "mock" is the default: offline, deterministic, no key. "ollama" uses a local Ollama server.
# "groq" is planned but NOT implemented yet.
LLM_PROVIDER=mock
# Local models can be slow, especially the first request while the model loads. When you switch to
# ollama, raise this (60 is a sensible start for qwen2.5:7b on a laptop). The default suits the mock.
LLM_TIMEOUT_SECONDS=10
# Used only when LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
MAX_MESSAGE_LENGTH=1000
# How many recent messages are sent to the provider as context
HISTORY_WINDOW=20
# How long a duplicate (same idempotency key) request waits for the first request's reply
IDEMPOTENCY_WAIT_SECONDS=3
# Seconds after which an unanswered inbound message is treated as abandoned and resumed on retry
PROCESSING_STALE_SECONDS=60
# Future hosted providers must read their credentials from environment variables only, e.g.
# GROQ_API_KEY=...   (not used yet)
